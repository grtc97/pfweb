ENVIRONMENT=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Token cap per answer (reasoning models use part of it for hidden reasoning)
OPENAI_MAX_COMPLETION_TOKENS=2000
# Leave empty for reasoning models (they only accept the default); e.g. 0.3 for gpt-4o-mini
OPENAI_TEMPERATURE=
CHAT_MODE=openai
CHAT_RATE_LIMIT=10
# Contact form: mock (no email, dev only) | resend (HTTPS API) | smtp (e.g. Gmail)
CONTACT_MODE=mock
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
CONTACT_RATE_LIMIT=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CHAT_CONTENT_PATH=app/content/chatcontent.md
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-site.vercel.app"]
